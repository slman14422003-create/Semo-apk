<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- يطابق getExternalFilesDir(Environment.DIRECTORY_PICTURES) المستخدم فعلياً
         في MainActivity.createImageFile(). قبل هذا التعديل لم يكن هناك أي
         <external-files-path> مطابق، فكان FileProvider.getUriForFile() يرمي
         IllegalArgumentException("Failed to find configured root...") في كل
         مرة يُفتح فيها منتقي الصور (صورة البروفايل/صورة الدردشة/الملصقات) -
         وهذا الاستثناء لم يكن ضمن try/catch فكان يُسقط التطبيق بالكامل. -->
    <external-files-path name="captured_images" path="Pictures/" />
    <external-cache-path name="captured_images_cache" path="." />
    <cache-path name="cache" path="." />
</paths>
